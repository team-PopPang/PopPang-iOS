default_platform(:ios)

platform :ios do

  # ⏱ xcodebuild -showBuildSettings 타임아웃 확장 (SPM 많은 프로젝트 필수)
  ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "60"
  ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "6"
  
  # =========================
  # 🚀 TestFlight
  # =========================
  desc "Push a new beta build to TestFlight using Fastlane Match"
  lane :beta do

    # 🔐 Match를 사용하여 코드 서명 정보 가져오기
    match(
      type: "appstore", # App Store용 프로비저닝 프로파일
      readonly: true     # 읽기 전용으로 사용 (이미 설정된 인증서를 활용)
    )

    # 📈 빌드 넘버 증가
    increment_build_number(xcodeproj: "PopPang.xcodeproj")

    # 🏗️ 앱 빌드 및 서명
    build_app(
      scheme: "PopPang",
      clean: true,
      disable_package_automatic_updates: true,
      xcargs: "-clonedSourcePackagesDirPath .spm",
      export_options: {
        provisioningProfiles: {
          "kr.co.poppang.PopPang" => "match AppStore kr.co.poppang.PopPang 1762797101"
        }
      }
    )

    # App Store Connect API 키 생성 (환경변수로부터 값 불러오기)
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      in_house: false
    )

    # 🚀 TestFlight 업로드
    upload_to_testflight(api_key: api_key)
  end  

  # =========================
  # 🏁 App Store Release
  # =========================
  desc "Release a new version to the App Store"
  lane :release do |options|

    # ---------
    # 🛑 안전 가드
    # ---------
    # ensure_git_status_clean
    # ensure_git_branch(branch: "main")

    # UI.confirm("⚠️ App Store에 실제로 제출합니다. 계속할까요?")

    version = options[:version]
    # UI.user_error!("version 파라미터가 필요합니다. 예: fastlane release version:1.1.3") if version.nil?

    # ---------
    # 1️⃣ 마케팅 버전 설정 (CFBundleShortVersionString)
    # ---------
    increment_version_number(
      version_number: version,
      xcodeproj: "PopPang.xcodeproj"
    )

    # ---------
    # 2️⃣ 빌드 + TestFlight 업로드
    # ---------
    beta

    # ---------
    # 3️⃣ 메타데이터 + 스크린샷 업로드
    # ---------
    deliver(
      skip_binary_upload: true,          # 이미 TestFlight로 바이너리를 올렸으니 IPA 재업로드는 건너뜀
      skip_screenshots: true,            # 기존 App Store Connect 스크린샷 그대로 사용
      submit_for_review: true,           # 메타데이터 업로드 후 즉시 App Store 심사 제출
      force: true,                       # Preview.html 확인(y/n) 질문 없이 자동 진행
      run_precheck_before_submit: false  # fastlane 사전 점검(precheck) 비활성화,
      # skip_metadata: false
    )

  end
end

# bundle exec fastlane release version:1.1.3

# fastlane deliver --verify_only -> 심사 제출 가능 상태인지 점검
