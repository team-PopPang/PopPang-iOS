import ProjectDescription

let project = Project(
    name: "{{ name }}Data",
    targets: [
        .target(
            name: "{{ name }}Data",
            destinations: .iOS,
            product: .framework,
            bundleId: "{{ bundleIdPrefix }}.data.{{ name | lowercase }}",
            deploymentTargets: .iOS("{{ deploymentTarget }}"),
            infoPlist: .default,
            sources: ["Sources/**"],
            dependencies: []
        ),
        .target(
            name: "{{ name }}DataTests",
            destinations: .iOS,
            product: .unitTests,
            bundleId: "{{ bundleIdPrefix }}.data.{{ name | lowercase }}.tests",
            deploymentTargets: .iOS("{{ deploymentTarget }}"),
            infoPlist: .default,
            sources: ["Tests/**"],
            dependencies: [.target(name: "{{ name }}Data")]
        ),
    ]
)
