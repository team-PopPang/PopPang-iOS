import ProjectDescription

let project = Project(
    name: "{{ name }}Feature",
    targets: [
        .target(
            name: "{{ name }}Feature",
            destinations: .iOS,
            product: .framework,
            bundleId: "{{ bundleIdPrefix }}.features.{{ name | lowercase }}",
            deploymentTargets: .iOS("{{ deploymentTarget }}"),
            infoPlist: .default,
            sources: [
                "Interface/**",
                "Sources/**",
            ],
            dependencies: []
        ),
        .target(
            name: "{{ name }}FeatureDemo",
            destinations: .iOS,
            product: .app,
            bundleId: "{{ bundleIdPrefix }}.demo.{{ name | lowercase }}",
            deploymentTargets: .iOS("{{ deploymentTarget }}"),
            infoPlist: .extendingDefault(
                with: [
                    "UILaunchScreen": [
                        "UIColorName": "",
                        "UIImageName": "",
                    ],
                ]
            ),
            sources: ["Demo/Sources/**"],
            dependencies: [.target(name: "{{ name }}Feature")]
        ),
        .target(
            name: "{{ name }}FeatureTests",
            destinations: .iOS,
            product: .unitTests,
            bundleId: "{{ bundleIdPrefix }}.features.{{ name | lowercase }}.tests",
            deploymentTargets: .iOS("{{ deploymentTarget }}"),
            infoPlist: .default,
            sources: ["Tests/**"],
            dependencies: [.target(name: "{{ name }}Feature")]
        ),
    ]
)
