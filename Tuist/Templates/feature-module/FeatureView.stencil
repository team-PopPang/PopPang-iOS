import SwiftUI

public struct {{ name }}FeatureView: View {
    @State private var compound = {{ name }}FeatureCompound()

    public init() {}

    public var body: some View {
        VStack(spacing: 12) {
            Text("{{ name }}Feature")
                .font(.title2)

            if compound.state.isLoading {
                ProgressView()
            }

            Button("새로고침") {
                compound.send(.refresh)
            }
        }
        .padding()
        .task {
            compound.send(.onAppear)
        }
    }
}
