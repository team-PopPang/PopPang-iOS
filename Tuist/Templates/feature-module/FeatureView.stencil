import SwiftUI

public struct {{ name }}FeatureView: View {
    @StateObject private var store: {{ name }}FeatureStore

    public init(store: {{ name }}FeatureStore) {
        _store = StateObject(wrappedValue: store)
    }

    public var body: some View {
        VStack(spacing: 12) {
            Text("{{ name }}Feature")
                .font(.title2)

            if store.state.isLoading {
                ProgressView()
            }

            Button("새로고침") {
                store.send(.refresh)
            }
        }
        .padding()
        .task {
            store.send(.onAppear)
        }
    }
}
