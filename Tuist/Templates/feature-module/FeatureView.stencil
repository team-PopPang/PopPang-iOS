import SwiftUI

struct {{ name }}FeatureView: View {
    private let compound: {{ name }}FeatureCompound

    init(compound: {{ name }}FeatureCompound) {
        self.compound = compound
    }

    public var body: some View {
        VStack(spacing: 12) {
            Text("{{ name }}Feature")
                .font(.title2)

            if compound.state.isLoading {
                ProgressView()
            }

            Button("새로고침") {
                compound.send(.refresh)
            }
        }
        .padding()
        .task {
            compound.send(.onAppear)
        }
    }
}
