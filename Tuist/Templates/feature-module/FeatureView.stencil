import SwiftUI

public struct {{ name }}FeatureView: View {
    @State private var isLoading = false

    public init() {}

    public var body: some View {
        VStack(spacing: 12) {
            Text("{{ name }}Feature")
                .font(.title2)

            if isLoading {
                ProgressView()
            }

            Button("새로고침") {
                isLoading.toggle()
            }
        }
        .padding()
        .task {
            isLoading = true
            isLoading = false
        }
    }
}
