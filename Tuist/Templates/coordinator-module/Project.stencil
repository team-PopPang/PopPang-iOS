import ProjectDescription

let project = Project(
    name: "{{ name }}Coordinator",
    targets: [
        .target(
            name: "{{ name }}Coordinator",
            destinations: .iOS,
            product: .framework,
            bundleId: "{{ bundleIdPrefix }}.coordinator.{{ name | lowercase }}",
            deploymentTargets: .iOS("{{ deploymentTarget }}"),
            infoPlist: .default,
            sources: ["Sources/**"],
            dependencies: []
        ),
        .target(
            name: "{{ name }}CoordinatorTests",
            destinations: .iOS,
            product: .unitTests,
            bundleId: "{{ bundleIdPrefix }}.coordinator.{{ name | lowercase }}.tests",
            deploymentTargets: .iOS("{{ deploymentTarget }}"),
            infoPlist: .default,
            sources: ["Tests/**"],
            dependencies: [.target(name: "{{ name }}Coordinator")]
        ),
    ]
)
