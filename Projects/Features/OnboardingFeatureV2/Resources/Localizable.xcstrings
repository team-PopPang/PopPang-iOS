{
  "sourceLanguage" : "ko",
  "strings" : {
    "가고 싶은 팝업은\n캘린더에 찜해두세요" : {
      "comment" : "Onboarding title for favorites calendar",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the popups you want to visit\nto your calendar"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行きたいポップアップは\nカレンダーに保存しましょう"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가고 싶은 팝업은\n캘린더에 찜해두세요"
          }
        }
      }
    },
    "건너뛰기" : {
      "comment" : "Action to skip onboarding",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip"
