        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ポップアップストアの情報を提供するために位置情報を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팝업스토어 정보 제공을 위해 사용자의 위치를 받습니다."
          }
        }
      }
    },
