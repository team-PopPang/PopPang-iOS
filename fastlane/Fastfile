require "json"
require "shellwords"
require "tempfile"

default_platform(:ios)

ROOT_DIR = File.expand_path("..", __dir__)
WORKSPACE = File.join(ROOT_DIR, "PopPang.xcworkspace")
APP_SCHEME = "PopPangApp"
CORE_SCHEME = "Core"
DATA_SCHEME = "Data"
APP_PROJECT = File.join(ROOT_DIR, "Projects/App/App.xcodeproj")
APP_PROJECT_MANIFEST = File.join(ROOT_DIR, "Projects/App/Project.swift")
APP_IDENTIFIER = "kr.co.poppang.PopPang"
SIMULATOR_DESTINATION = "generic/platform=iOS Simulator"
TEST_DEVICE = "iPhone 16"
METADATA_PATH = File.join(ROOT_DIR, "fastlane/metadata")
SCREENSHOTS_PATH = File.join(ROOT_DIR, "fastlane/screenshots")
APP_STORE_CONNECT_API_KEY_ENV = %w[
  APP_STORE_CONNECT_API_KEY_ID
  APP_STORE_CONNECT_API_KEY_ISSUER_ID
  APP_STORE_CONNECT_API_KEY_CONTENT
].freeze

# 생성된 xcodeproj가 없어도 버전을 알 수 있도록 Tuist 설정에서 MARKETING_VERSION을 읽는다.
def project_marketing_version
  version = File.read(APP_PROJECT_MANIFEST, encoding: "UTF-8")[/"MARKETING_VERSION":\s*"([^"]+)"/, 1]
  UI.user_error!("#{APP_PROJECT_MANIFEST}에서 MARKETING_VERSION을 찾지 못했습니다.") if version.nil?
  version
end

def next_patch_version(version)
  parts = version.split(".").map(&:to_i)
  parts << 0 while parts.length < 3
  parts[2] += 1
  parts.join(".")
end

def describe_app_store_version(version)
  return "없음" if version.nil?

  "#{version.version_string} (#{version.app_version_state || version.app_store_state})"
end

def truthy?(value)
  [true, "true", "1", "yes"].include?(value)
end

def ensure_app_store_connect_api_key_env!
  missing = APP_STORE_CONNECT_API_KEY_ENV.select { |name| ENV[name].to_s.strip.empty? }
  return if missing.empty?

  UI.user_error!("fastlane/.env에 #{missing.join(', ')} 값을 넣어 주세요. 방법은 Docs/development/app-store-release.md에 있습니다.")
end

# deliver의 download 명령은 API 키를 파일로만 받는다. 환경 변수로 임시 파일을 만들고, 끝나면 지운다.
def with_app_store_connect_api_key_file
  ensure_app_store_connect_api_key_env!
  file = Tempfile.new(["app_store_connect_api_key", ".json"])
  File.chmod(0o600, file.path)
  file.write(JSON.generate(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
    key: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
    in_house: false
  ))
  file.close
  yield file.path
ensure
  file&.close!
end

def fastlane_command
  FastlaneCore::Helper.bundler? ? "bundle exec fastlane" : "fastlane"
end

platform :ios do
  ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "60"
  ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "6"

  desc "Install Tuist dependencies and generate the modular workspace"
  private_lane :prepare_tuist do
    sh("cd #{ROOT_DIR.shellescape} && tuist install")
    sh("cd #{ROOT_DIR.shellescape} && tuist generate --no-open")
  end

  desc "Build the modular PopPang app"
  lane :build do
    prepare_tuist

    build_app(
      workspace: WORKSPACE,
      scheme: APP_SCHEME,
      clean: true,
      skip_archive: true,
      destination: SIMULATOR_DESTINATION,
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end

  desc "Run the maintained modular test schemes"
  lane :test do
    prepare_tuist

    scan(
      workspace: WORKSPACE,
      scheme: CORE_SCHEME,
      device: TEST_DEVICE,
      clean: true,
      code_coverage: true
    )

    scan(
      workspace: WORKSPACE,
      scheme: DATA_SCHEME,
      device: TEST_DEVICE,
      clean: false,
      code_coverage: true
    )
  end

  desc "Build PopPangApp and run Core/Data tests"
  lane :ci do
    build
    test
  end

  desc "Archive and upload the modular app to TestFlight"
  lane :beta do |options|
    prepare_tuist unless options[:skip_prepare]

    # tuist generate가 빌드 번호를 1로 되돌리므로, TestFlight에 있는 같은 버전의 마지막 번호에 1을 더한다.
    version = get_version_number(xcodeproj: APP_PROJECT, target: APP_SCHEME, configuration: "Release")
    asc_api_key
    latest_build = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      version: version,
      initial_build_number: 0
    )
    increment_build_number(xcodeproj: APP_PROJECT, build_number: (latest_build.to_i + 1).to_s)

    archive_and_upload
  end

  desc "Release a new modular app version to the App Store"
  lane :release do |options|
    version = options[:version]
    UI.user_error!("version 파라미터가 필요합니다. 예: fastlane release version:1.1.3") if version.nil?

    prepare_tuist
    increment_version_number(version_number: version, xcodeproj: APP_PROJECT)
    beta(skip_prepare: true)

    deliver(
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Compare the App Store versions with the project version without changing anything"
  lane :release_status do
    asc_api_key
    project_version = project_marketing_version
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App Store Connect에서 #{APP_IDENTIFIER} 앱을 찾지 못했습니다.") if app.nil?

    live = app.get_live_app_store_version
    pending = app.get_pending_release_app_store_version
    in_review = app.get_in_review_app_store_version
    editing = app.get_edit_app_store_version

    # 승인된 버전(출시됨 또는 출시 대기)과 같거나 낮은 버전으로는 새 빌드를 올릴 수 없다.
    approved = [live, pending].compact.map(&:version_string).max_by { |version| Gem::Version.new(version) }
    status =
      if approved && Gem::Version.new(project_version) <= Gem::Version.new(approved)
        "BUMP_REQUIRED"
      elsif in_review&.version_string == project_version
        "IN_REVIEW"
      else
        "READY"
      end

    latest_build = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      version: project_version,
      initial_build_number: 0
    )

    UI.message("프로젝트 버전: #{project_version}")
    UI.message("출시된 버전: #{describe_app_store_version(live)}")
    UI.message("출시 대기 중인 버전: #{describe_app_store_version(pending)}")
    UI.message("심사 중인 버전: #{describe_app_store_version(in_review)}")
    UI.message("준비 중인 버전: #{describe_app_store_version(editing)}")
    UI.message("TestFlight에 있는 #{project_version}의 마지막 빌드 번호: #{latest_build}")
    UI.important("RELEASE_STATUS=#{status}")
    UI.important("SUGGESTED_VERSION=#{next_patch_version(approved)}") if status == "BUMP_REQUIRED"
  end

  desc "Download App Store metadata, and screenshots with screenshots:true, without changing App Store Connect"
  lane :download_store_metadata do |options|
    download_screenshots = truthy?(options[:screenshots])
    if download_screenshots
      # 준비 중인 버전이 없으면 deliver가 스크린샷을 찾지 못하므로 출시된 버전에서 받는다.
      asc_api_key
      app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
      UI.user_error!("App Store Connect에서 #{APP_IDENTIFIER} 앱을 찾지 못했습니다.") if app.nil?
      use_live_version = app.get_edit_app_store_version.nil?
    end

    with_app_store_connect_api_key_file do |key_path|
      common_options = "--api_key_path #{key_path.shellescape} --app_identifier #{APP_IDENTIFIER.shellescape}"
      sh("#{fastlane_command} deliver download_metadata #{common_options} --metadata_path #{METADATA_PATH.shellescape} --force")

      if download_screenshots
        version_option = use_live_version ? " --use_live_version true" : ""
        sh("#{fastlane_command} deliver download_screenshots #{common_options} --screenshots_path #{SCREENSHOTS_PATH.shellescape}#{version_option}")
      end
    end
  end

  desc "Upload the edited App Store metadata without uploading a build or submitting for review"
  lane :upload_store_metadata do |options|
    version = options[:version] || project_marketing_version
    upload_screenshots = truthy?(options[:screenshots])
    UI.user_error!("#{METADATA_PATH}가 없습니다. 먼저 download_store_metadata를 실행해 주세요.") unless File.directory?(METADATA_PATH)
    if upload_screenshots && !File.directory?(SCREENSHOTS_PATH)
      UI.user_error!("#{SCREENSHOTS_PATH}가 없습니다. 먼저 download_store_metadata screenshots:true를 실행해 주세요.")
    end

    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: version,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      skip_binary_upload: true,
      skip_screenshots: !upload_screenshots,
      overwrite_screenshots: upload_screenshots,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  private_lane :asc_api_key do
    ensure_app_store_connect_api_key_env!
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      in_house: false
    )
  end

  private_lane :archive_and_upload do
    match(
      type: "appstore",
      readonly: true
    )

    build_app(
      workspace: WORKSPACE,
      scheme: APP_SCHEME,
      clean: true,
      export_method: "app-store",
      disable_package_automatic_updates: true,
      xcargs: "-skipPackagePluginValidation -skipMacroValidation",
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => "match AppStore kr.co.poppang.PopPang"
        }
      }
    )

    upload_to_testflight(api_key: asc_api_key)
  end
end
