import ProjectDescription

let project = Project(
    name: "{{ name }}SDK",
    targets: [
        .target(
            name: "{{ name }}SDK",
            destinations: [.iPhone],
            product: .framework,
            bundleId: "{{ bundleIdPrefix }}.thirdparty.{{ name | lowercase }}",
            deploymentTargets: .iOS("{{ deploymentTarget }}"),
            infoPlist: .default,
            sources: ["Sources/**"],
            dependencies: []
        ),
        .target(
            name: "{{ name }}SDKTests",
            destinations: [.iPhone],
            product: .unitTests,
            bundleId: "{{ bundleIdPrefix }}.thirdparty.{{ name | lowercase }}.tests",
            deploymentTargets: .iOS("{{ deploymentTarget }}"),
            infoPlist: .default,
            sources: ["Tests/**"],
            dependencies: [.target(name: "{{ name }}SDK")]
        ),
    ]
)
