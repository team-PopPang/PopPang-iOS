{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/log_user_prompt.py",
            "timeout": 10,
            "statusMessage": "Logging user prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/log_pre_tool_use.py",
            "timeout": 10,
            "statusMessage": "Logging tool request"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/log_post_tool_use.py",
            "timeout": 10,
            "statusMessage": "Logging tool result"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/log_stop.py",
            "timeout": 10,
            "statusMessage": "Logging turn stop"
          }
        ]
      }
    ]
  }
}
